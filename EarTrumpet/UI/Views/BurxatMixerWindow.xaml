<Window x:Class="EarTrumpet.UI.Views.BurxatMixerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:Theme="clr-namespace:EarTrumpet.UI.Themes"
        xmlns:resx="clr-namespace:EarTrumpet.Properties"
        xmlns:vm="clr-namespace:EarTrumpet.UI.ViewModels"
        Name="WindowRoot"
        Title="Burxat's Mixer for EarTrumpet"
        Theme:AcrylicBrush.Background="AcrylicColor_Settings"
        Theme:Options.Source="App"
        Width="700"
        Height="900"
        MinWidth="480"
        MinHeight="500"
        ResizeMode="CanResize"
        Style="{StaticResource DialogWindowStyle}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <!--  Default (Dark) palette - BurxatMixerWindow.xaml.cs overwrites these entries live when the theme changes.  -->
        <SolidColorBrush x:Key="BurxatWindowBackground" Color="#FF1B1B1B" />
        <SolidColorBrush x:Key="BurxatText" Color="#FFF2F2F2" />
        <SolidColorBrush x:Key="BurxatSubtleText" Color="#FFAFAFAF" />
        <SolidColorBrush x:Key="BurxatCardBackground" Color="#FF2A2A2A" />
        <SolidColorBrush x:Key="BurxatZoneBackground" Color="#FF242424" />
        <SolidColorBrush x:Key="BurxatTrack" Color="#FF4A4A4A" />
        <SolidColorBrush x:Key="BurxatFaderThumb" Color="#FFE8E8E8" />
        <SolidColorBrush x:Key="BurxatBorder" Color="#FF7A7A7A" />
        <FontFamily x:Key="BurxatFontFamily">Segoe UI</FontFamily>

        <!--  A slim track + rectangular cap, closer to a physical mixer fader than the app's default slider.  -->
        <Style x:Key="AnalogFaderStyle" TargetType="{x:Type Slider}">
            <Setter Property="Minimum" Value="0" />
            <Setter Property="Maximum" Value="100" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Slider}">
                        <Grid VerticalAlignment="Center">
                            <Border Height="4"
                                    Background="{DynamicResource BurxatTrack}"
                                    CornerRadius="2" />
                            <Track Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="{x:Type RepeatButton}">
                                                <Border Background="Transparent" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="14" Height="22">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="{x:Type Thumb}">
                                                <Border Background="{DynamicResource BurxatFaderThumb}" CornerRadius="2" />
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="{x:Type RepeatButton}">
                                                <Border Background="Transparent" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate DataType="{x:Type vm:MixerAppViewModel}">
            <Border Margin="0,3,0,0"
                    Padding="6,3"
                    Cursor="Hand"
                    PreviewMouseLeftButtonDown="AppChip_PreviewMouseLeftButtonDown"
                    PreviewMouseMove="AppChip_PreviewMouseMove"
                    Background="{DynamicResource BurxatCardBackground}"
                    ToolTipService.InitialShowDelay="1200"
                    ToolTipService.ToolTip="{Binding DisplayName}"
                    CornerRadius="3">
                <Border.Style>
                    <Style TargetType="Border">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsMovable}" Value="True">
                                <Setter Property="ContextMenu">
                                    <Setter.Value>
                                        <ContextMenu ItemsSource="{Binding MoveMenu}"
                                                     ItemContainerTemplateSelector="{StaticResource MenuSelector}"
                                                     UsesItemContainerTemplate="True" />
                                    </Setter.Value>
                                </Setter>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" />
                    <Grid Margin="0,3,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="30" />
                        </Grid.ColumnDefinitions>
                        <Slider Grid.Column="0"
                                Style="{StaticResource AnalogFaderStyle}"
                                Value="{Binding App.Volume, Mode=TwoWay}" />
                        <TextBlock Grid.Column="1"
                                   HorizontalAlignment="Right"
                                   FontSize="10"
                                   Text="{Binding App.Volume, Mode=OneWay}" />
                    </Grid>
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:MixerChannelViewModel}">
            <StackPanel Width="220"
                        Margin="10,6"
                        AllowDrop="True"
                        Drop="Channel_Drop"
                        DragOver="Channel_DragOver">
                <StackPanel.ContextMenu>
                    <ContextMenu ItemsSource="{Binding DeviceMenu}"
                                 ItemContainerTemplateSelector="{StaticResource MenuSelector}"
                                 UsesItemContainerTemplate="True" />
                </StackPanel.ContextMenu>
                <StackPanel Cursor="Hand" PreviewMouseLeftButtonDown="ChannelHeader_PreviewMouseLeftButtonDown">
                    <TextBlock FontSize="18"
                               FontWeight="Bold"
                               Text="{Binding OrdinalLabel}" />
                    <TextBlock Margin="0,6,0,0"
                               FontWeight="SemiBold"
                               Text="{Binding DisplayName}"
                               TextTrimming="CharacterEllipsis"
                               ToolTipService.InitialShowDelay="1200"
                               ToolTipService.ToolTip="{Binding DisplayName}" />
                    <TextBlock FontSize="10" TextWrapping="Wrap">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="{Binding DoubleClickHintText}" />
                                <Setter Property="Foreground" Value="{DynamicResource BurxatSubtleText}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsDefault}" Value="True">
                                        <Setter Property="Text" Value="{Binding DefaultDeviceLabelText}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>

                <Grid Margin="0,6,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="36" />
                    </Grid.ColumnDefinitions>
                    <Slider Grid.Column="0"
                            Style="{StaticResource AnalogFaderStyle}"
                            Value="{Binding Volume, Mode=TwoWay}" />
                    <TextBlock Grid.Column="1"
                               HorizontalAlignment="Right"
                               Text="{Binding Volume, Mode=OneWay}" />
                </Grid>

                <Grid Margin="0,4,0,0" MinHeight="34">
                    <Rectangle RadiusX="4"
                               RadiusY="4"
                               Stroke="{DynamicResource BurxatBorder}"
                               StrokeDashArray="3,2"
                               StrokeThickness="1" />
                    <TextBlock Margin="6,4"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Text="{Binding DropHintText}"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource BurxatSubtleText}" />
                </Grid>

                <ItemsControl Margin="0,4,0,0" ItemsSource="{Binding Apps}" />
            </StackPanel>
        </DataTemplate>

        <!--  A section of the mixer for one device kind: a leading full-width rule, its master
              fader, then its device columns in a softly-tinted zone box.  -->
        <DataTemplate x:Key="MixerZoneTemplate" DataType="{x:Type vm:BurxatMixerViewModel}">
            <StackPanel>
                <Grid Margin="14,10,14,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Rectangle Grid.Column="0"
                               Height="2"
                               Margin="0,0,14,0"
                               VerticalAlignment="Center"
                               Fill="{DynamicResource BurxatText}"
                               Opacity="0.85" />
                    <TextBlock Grid.Column="1"
                               FontSize="18"
                               FontWeight="Bold"
                               Text="{Binding MasterFaderLabel}" />
                    <Rectangle Grid.Column="2"
                               Height="2"
                               Margin="14,0,0,0"
                               VerticalAlignment="Center"
                               Fill="{DynamicResource BurxatText}"
                               Opacity="0.85" />
                </Grid>

                <StackPanel Width="220"
                            Margin="10,10,10,6"
                            HorizontalAlignment="Center"
                            AllowDrop="True"
                            DragOver="Channel_DragOver"
                            Drop="MasterFader_Drop">
                    <Grid Margin="0,0,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="36" />
                        </Grid.ColumnDefinitions>
                        <Slider Grid.Column="0"
                                Style="{StaticResource AnalogFaderStyle}"
                                Value="{Binding MasterVolume, Mode=TwoWay}" />
                        <TextBlock Grid.Column="1"
                                   HorizontalAlignment="Right"
                                   Text="{Binding MasterVolume, Mode=OneWay}" />
                    </Grid>
                    <Grid Margin="0,4,0,0" MinHeight="34">
                        <Rectangle RadiusX="4"
                                   RadiusY="4"
                                   Stroke="{DynamicResource BurxatBorder}"
                                   StrokeDashArray="3,2"
                                   StrokeThickness="1" />
                        <TextBlock Margin="6,4"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontSize="10"
                                   Text="{Binding ResetHintText}"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource BurxatSubtleText}" />
                    </Grid>
                </StackPanel>

                <!--  The horizontally-scrollable row of this zone's devices, boxed in a soft,
                      theme-following tint so it reads as one group - the devices stay the
                      visual focus, so the tint is deliberately subtle.  -->
                <Border Margin="14,10,14,16"
                        Background="{DynamicResource BurxatZoneBackground}"
                        CornerRadius="8">
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                        <ItemsControl Margin="0,4,0,8"
                                      HorizontalAlignment="Center"
                                      ItemsSource="{Binding Channels}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>
            </StackPanel>
        </DataTemplate>
    </Window.Resources>
    <!--
        The Window's own Background must stay whatever DialogWindowStyle sets (Transparent), since
        AllowsTransparency + the custom WindowChrome need that to hit-test correctly - painting the
        theme color here instead, on an opaque child, keeps clicks working.
    -->
    <Border Background="{DynamicResource BurxatWindowBackground}"
            TextElement.FontFamily="{DynamicResource BurxatFontFamily}"
            TextElement.Foreground="{DynamicResource BurxatText}">
        <DockPanel Name="RootContent" LastChildFill="True">
        <Grid DockPanel.Dock="Top">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Margin="14,0,0,0"
                       Text="Burxat's Mixer for EarTrumpet"
                       TextAlignment="Left" />
            <Button x:Name="SettingsButton"
                    Grid.Column="1"
                    Click="SettingsButton_Click"
                    ToolTipService.ToolTip="Settings">
                <Button.Style>
                    <Style BasedOn="{StaticResource CaptionButtonStyle}" TargetType="Button">
                        <Setter Property="Content" Value="&#xE713;" />
                    </Style>
                </Button.Style>
            </Button>
            <Button x:Name="MinimizeButton"
                    Grid.Column="2"
                    Style="{StaticResource MinimizeButton}" />
            <Button x:Name="MaximizeRestoreButton"
                    Grid.Column="3"
                    Style="{StaticResource MaximizeButton}" />
            <Button x:Name="CloseButton"
                    Grid.Column="4"
                    Style="{StaticResource CloseButtonStyle}" />
        </Grid>

        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,0,12">
                <ContentControl Content="{Binding Output}" ContentTemplate="{StaticResource MixerZoneTemplate}" />
                <ContentControl Content="{Binding Input}" ContentTemplate="{StaticResource MixerZoneTemplate}" />
            </StackPanel>
        </ScrollViewer>
        </DockPanel>
    </Border>
</Window>
